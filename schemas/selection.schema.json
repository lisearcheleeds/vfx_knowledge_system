{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit dependency selection (not an effect compiler)",
  "type": "object", "additionalProperties": false,
  "required": ["selected_nodes", "engine", "conditional_decisions"],
  "properties": {
    "selected_nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "engine": {"type": ["string", "null"], "minLength": 1},
    "conditional_decisions": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "source_revision", "relation_index", "applies", "reason"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "source_revision": {"type": "integer", "minimum": 1},
          "relation_index": {"type": "integer", "minimum": 0},
          "applies": {"type": "boolean"},
          "reason": {"type": "string", "pattern": "\\S"}
        }
      }
    }
  }
}
